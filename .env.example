# Static site environment variables (optional — every value has a default).
# Copy to `.env` and adjust. Vite inlines these at build time, so rebuild after
# changing them.

# Origin of the comments/accounts API. All comment, account, analytics and
# notification-link requests are sent here.
PUBLIC_BLOG_API=https://api.loopo.cc

# Log `[comments] …` traces (mount, requests, payloads, timings) to the console.
PUBLIC_COMMENTS_DEBUG=false

# Google Search Console verification value; emits the `google-site-verification`
# meta tag when set.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# The comments backend has its own, separate environment file:
# see `backends/.env.example`.
