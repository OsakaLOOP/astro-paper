SITE_DATABASE_URL=postgresql://blog_app:change-me@127.0.0.1:5432/sm
SITE_ISSUER=https://auth.loopo.cc/api/auth
SITE_CLIENT_ID=
SITE_CLIENT_SECRET=
SITE_SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=https://www.loopo.cc,https://loopo.cc
MODERATOR_IDS=
AUTHOR_USER_ID=
AUTHOR_EMAIL=
AUTO_SUBSCRIBE_COMMENTS_DEFAULT=false
CONTENT_NOTIFICATIONS_DEFAULT=false
COMMENTS_DEBUG=false
