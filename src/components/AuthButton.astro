---
import LinkButton from "./LinkButton.astro";
const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
---

<div
  class="auth-control"
  data-auth-api={api}
  data-auth-me={`${api}/blog/auth/me`}
>
  <LinkButton
    href={`${api}/blog/auth/login?returnTo=${encodeURIComponent(Astro.url.href)}`}
    class="auth-link">Log in</LinkButton
  >
</div>
<script>
  import {
    BlogRequestError,
    describeBlogError,
    requestBlogApi,
  } from "@/scripts/blog-api";
  type Identity = { id: string; name: string };
  type IdentityError = BlogRequestError & { retryAfterMs?: number };
  const identityCache = new Map<
    string,
    {
      value?: Identity | null;
      expiresAt: number;
      request?: Promise<Identity | null>;
      blockedUntil: number;
    }
  >();
  const identityTtl = 30_000;
  const rateLimitBackoff = 15_000;
  const requests = new Map<HTMLElement, AbortController>();
  const bound = new WeakSet<HTMLElement>();
  function showError(control: HTMLElement, error: unknown) {
    const message = document.createElement("span");
    message.className = "auth-error";
    message.setAttribute("role", "alert");
    message.textContent = `Account unavailable. ${describeBlogError(error)}`;
    const retry = document.createElement("button");
    retry.type = "button";
    retry.className = "auth-link auth-button";
    retry.dataset.authRetry = "";
    retry.textContent = "Try again";
    control.replaceChildren(message, retry);
  }
  async function loadIdentity(control: HTMLElement) {
    const me = control.dataset.authMe;
    const api = control.dataset.authApi;
    if (!me || !api) return;
    const cached = identityCache.get(me) ?? { expiresAt: 0, blockedUntil: 0 };
    identityCache.set(me, cached);
    const now = Date.now();
    if (cached.request) {
      try {
        applyIdentityValue(control, api, await cached.request);
      } catch (error) {
        if (error instanceof BlogRequestError && error.status === 401)
          showLogin(control, api);
        else showError(control, error);
      }
      return;
    }
    if (cached.expiresAt > now && "value" in cached) {
      applyIdentityValue(control, api, cached.value ?? null);
      return;
    }
    if (cached.blockedUntil > now) {
      showError(control, new BlogRequestError("http", 429, "RATE_LIMITED"));
      return;
    }
    const request = requestBlogApi<Identity>(me)
      .then(user => {
        if (
          !user ||
          typeof user.id !== "string" ||
          typeof user.name !== "string"
        )
          throw new BlogRequestError("response");
        cached.value = user;
        cached.expiresAt = Date.now() + identityTtl;
        cached.blockedUntil = 0;
        return user;
      })
      .catch(error => {
        const typed = error as IdentityError;
        if (typed.status === 429)
          cached.blockedUntil =
            Date.now() + (typed.retryAfterMs || rateLimitBackoff);
        throw error;
      })
      .finally(() => {
        cached.request = undefined;
      });
    cached.request = request;
    try {
      applyIdentityValue(control, api, await request);
    } catch (error) {
      if (error instanceof BlogRequestError && error.status === 401)
        showLogin(control, api);
      else showError(control, error);
    }
  }
  function showLogin(control: HTMLElement, api: string) {
    const link = document.createElement("a");
    link.className =
      "group inline-flex items-center gap-1 hover:text-accent auth-link";
    link.href = `${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href)}`;
    link.textContent = "Log in";
    control.replaceChildren(link);
  }
  function applyIdentityValue(
    control: HTMLElement,
    api: string,
    user: Identity | null
  ) {
    if (!user) {
      const link = document.createElement("a");
      link.className =
        "group inline-flex items-center gap-1 hover:text-accent auth-link";
      link.href = `${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href)}`;
      link.textContent = "Log in";
      control.replaceChildren(link);
      return;
    }
    let accountLink =
      control.querySelector<HTMLAnchorElement>("[data-auth-link]");
    if (!accountLink) {
      control.innerHTML = `<a class="auth-name nav-link" data-auth-link href="/account"><span class="auth-name-label"></span></a><span class="auth-divider" aria-hidden="true">·</span><button class="auth-link auth-button" type="button" data-auth-logout>Log out</button>`;
      accountLink =
        control.querySelector<HTMLAnchorElement>("[data-auth-link]")!;
    }
    const displayName = user.name || "Reader";
    accountLink.querySelector<HTMLElement>(".auth-name-label")!.textContent =
      displayName;
    accountLink.title = displayName;
    document.dispatchEvent(new CustomEvent("auth:updated"));
  }
  function initAuthControls() {
    for (const control of document.querySelectorAll<HTMLElement>(
      ".auth-control"
    )) {
      if (!bound.has(control)) {
        bound.add(control);
        control.addEventListener("click", async event => {
          const button = (
            event.target as HTMLElement
          ).closest<HTMLButtonElement>("[data-auth-retry],[data-auth-logout]");
          if (!button || button.disabled) return;
          button.disabled = true;
          if (button.hasAttribute("data-auth-retry")) {
            await loadIdentity(control);
            return;
          }
          requests.get(control)?.abort();
          const controller = new AbortController();
          requests.set(control, controller);
          try {
            await requestBlogApi(
              `${control.dataset.authApi}/blog/auth/logout`,
              { method: "POST", signal: controller.signal }
            );
            identityCache.delete(control.dataset.authMe ?? "");
            if (!controller.signal.aborted && control.isConnected)
              location.reload();
          } catch (error) {
            if (!controller.signal.aborted && control.isConnected)
              showError(control, error);
          } finally {
            button.disabled = false;
            if (requests.get(control) === controller) requests.delete(control);
          }
        });
      }
      void loadIdentity(control);
    }
  }

  function scheduleAuthControls() {
    const run = () => initAuthControls();
    const idleWindow = window as Window & {
      requestIdleCallback?: (
        callback: () => void,
        options?: { timeout: number }
      ) => number;
    };
    if (idleWindow.requestIdleCallback) {
      idleWindow.requestIdleCallback(run, { timeout: 5000 });
    } else {
      window.setTimeout(run, 5000);
    }
  }

  document.addEventListener("astro:before-swap", () => {
    requests.clear();
  });
  document.addEventListener("astro:page-load", scheduleAuthControls);
  document
    .querySelector("#menu-btn")
    ?.addEventListener("click", initAuthControls, {
      once: true,
    });
  if (document.readyState === "complete") scheduleAuthControls();
</script>
