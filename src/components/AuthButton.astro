---
import LinkButton from "./LinkButton.astro";
const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
---
<div class="auth-control" data-auth-api={api} data-auth-me={`${api}/blog/auth/me`}>
  <LinkButton href={`${api}/blog/auth/login?returnTo=${encodeURIComponent(Astro.url.href)}`} class="auth-link">Log in</LinkButton>
</div>
<script>
  const controls = [...document.querySelectorAll<HTMLElement>(".auth-control")];
  for (const control of controls) {
    const me = control.dataset.authMe;
    const api = control.dataset.authApi;
    if (!me || !api) continue;
    fetch(me, { credentials: "include" }).then(async response => {
      if (!response.ok) return;
      const user = await response.json();
      control.innerHTML = `<a class="auth-name" href="/account">${String(user.name ?? "Reader").replace(/[&<>"']/g, "")}</a><span class="auth-divider" aria-hidden="true">·</span><button class="auth-link auth-button" type="button">Log out</button>`;
      control.querySelector(".auth-button")?.addEventListener("click", async () => {
        await fetch(`${api}/blog/auth/logout`, { method: "POST", credentials: "include", headers: { Origin: location.origin } });
        location.reload();
      });
    }).catch(() => {});
  }
</script>
