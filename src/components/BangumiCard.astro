---
import type { BangumiCardData } from "../../backends/src/bangumi";
import {
  bangumiTypes,
  collectionStatus,
  collectionProgress,
} from "@/utils/bangumi";

interface Props {
  subjectId: number;
  title?: string;
}
const { subjectId, title } = Astro.props;
const snapshots = import.meta.glob<{ default: BangumiCardData }>(
  "../data/bangumi/*.json",
  { eager: true }
);
const snapshot = snapshots["../data/bangumi/" + subjectId + ".json"]?.default;
const subject = snapshot?.subject;
const collection = snapshot?.collection;
const maximum = Math.max(1, ...(subject?.counts ?? []));
const url = "https://bangumi.tv/subject/" + subjectId;
const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
---

<article
  class="bangumi-card not-prose"
  data-bangumi-card
  data-subject-id={subjectId}
  data-subject-type={subject?.type}
  data-api={api}
  aria-label="Bangumi 作品信息"
>
  <header class="bangumi-header">
    <a
      class="bangumi-brand"
      href="https://bangumi.tv/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Bangumi 番组计划"
    >
      <span class="bangumi-logo" aria-hidden="true"></span><span>bangumi</span>
    </a>
    <a
      class="bangumi-source"
      href={url}
      target="_blank"
      rel="noopener noreferrer">作品详情 ↗</a
    >
  </header>
  <div class="bangumi-body">
    <a
      class="bangumi-cover"
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="在 Bangumi 查看作品封面"
    >
      <span aria-hidden="true">暂无封面</span>
      <img
        data-cover
        src={subject?.image
          ? new URL(`/blog/bangumi/subjects/${subjectId}/cover`, api).href
          : undefined}
        alt={subject?.name ?? title ?? "作品封面"}
        width="120"
        height="174"
        loading="lazy"
        hidden={!subject?.image}
      />
    </a>
    <div class="bangumi-info">
      <div class="bangumi-category" data-category>
        {
          [subject?.platform || bangumiTypes[subject?.type ?? 0], subject?.date]
            .filter(Boolean)
            .join(" · ")
        }
      </div>
      <a
        class="bangumi-title"
        data-title
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        >{
          subject?.nameCn || subject?.name || title || `Bangumi #${subjectId}`
        }</a
      >
      <div class="bangumi-original" data-original hidden={!subject?.nameCn}>
        {subject?.name}
      </div>
      <dl class="bangumi-meta" data-meta>
        {
          subject?.infobox.map(item => (
            <div>
              <>
                <dt>{item.key}</dt>
                <dd>{item.value}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>
    <aside class="bangumi-rating" aria-label="Bangumi 评分">
      <div class="bangumi-score">
        <strong data-score
          >{subject?.total ? subject.score.toFixed(1) : "—"}</strong
        ><span>/ 10</span>
      </div>
      <div class="bangumi-votes" data-votes>
        {subject?.total ?? 0} 人评分{subject?.rank ? ` · #${subject.rank}` : ""}
      </div>
      <div
        class="bangumi-chart"
        role="img"
        data-chart
        aria-label={subject?.total
          ? `评分分布：${subject.counts.map((count, i) => `${i + 1}分 ${count}人`).join("，")}`
          : "暂无评分"}
      >
        {
          Array.from({ length: 10 }, (_, i) => (
            <div
              class="bangumi-column"
              title={`${i + 1} 分：${subject?.counts[i] ?? 0} 人`}
            >
              <>
                <span class="bangumi-track">
                  <span
                    data-bar
                    style={`height: ${((subject?.counts[i] ?? 0) / maximum) * 100}%`}
                  />
                </span>
                <span class="bangumi-tick">{i + 1}</span>
              </>
            </div>
          ))
        }
      </div>
    </aside>
    <div class="bangumi-description">
      <p class="bangumi-summary" data-summary hidden={!subject?.summary}>
        {subject?.summary.replaceAll("&amp;", "&")}
      </p>
      <button
        class="bangumi-summary-toggle"
        type="button"
        data-summary-toggle
        aria-expanded="false"
        hidden>展开简介</button
      >
    </div>
  </div>
  <footer class="bangumi-footer">
    <div class="bangumi-personal" data-personal hidden={!collection}>
      <a
        data-owner
        href={collection
          ? `https://bangumi.tv/user/${encodeURIComponent(collection.username)}`
          : undefined}
        target="_blank"
        rel="noopener noreferrer">{collection?.nickname}</a
      >
      <span data-progress
        >{
          collection ? collectionStatus(subject!.type, collection.status) : ""
        }</span
      >
      <strong data-personal-score
        >{collection?.rate ? `${collection.rate} / 10` : "未评分"}</strong
      >
      <span class="bangumi-episodes" data-episodes
        >{
          collection
            ? collectionProgress(
                subject!.type,
                collection.episodes,
                collection.volumes,
                subject!.episodes,
                subject!.volumes
              )
            : ""
        }</span
      >
    </div>
    <span class="bangumi-note" data-note role="status"
      >{
        snapshot
          ? `更新于 ${snapshot.updatedAt.slice(0, 10)}`
          : "作品信息加载中"
      }</span
    >
  </footer>
</article>

<script>
  import "@/scripts/bangumi-card";
</script>

<style>
  .bangumi-card {
    width: 100%;
    min-width: 0;
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--font-app);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .bangumi-card a {
    color: inherit;
    text-decoration: none;
  }
  .bangumi-card a:hover {
    color: var(--accent);
  }
  .bangumi-card a:focus-visible,
  .bangumi-summary-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .bangumi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .bangumi-brand {
    display: flex;
    align-items: center;
    color: #d94a7a !important;
    font-size: 1.1rem;
    font-weight: 700;
    font-style: italic;
  }
  .bangumi-brand > span {
    color: inherit;
  }
  .bangumi-logo {
    width: 40px;
    height: 40px;
    background: url("/images/bangumi-logo.png") 0 -10px / 280px 75px no-repeat;
  }
  .bangumi-source,
  .bangumi-category,
  .bangumi-original,
  .bangumi-votes,
  .bangumi-note,
  .bangumi-episodes {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
  .bangumi-source {
    flex-shrink: 0;
  }
  .bangumi-body {
    display: grid;
    grid-template-columns: 106px minmax(0, 1fr) 148px;
    align-items: start;
    gap: 1rem;
    padding: 1rem;
  }
  .bangumi-cover {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--muted);
    color: var(--muted-foreground) !important;
    font-size: 0.75rem;
  }
  .bangumi-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: contain;
  }
  .bangumi-card[data-subject-type="3"] .bangumi-cover {
    aspect-ratio: 1;
  }
  .bangumi-info {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .bangumi-title {
    display: block;
    margin: 0.2rem 0 0.5rem;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.5;
  }
  .bangumi-original {
    margin-bottom: 0.5rem;
  }
  .bangumi-meta {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }
  .bangumi-meta :global(div) {
    display: flex;
    gap: 0.5rem;
  }
  .bangumi-meta :global(dt) {
    flex-shrink: 0;
    color: var(--muted-foreground);
  }
  .bangumi-meta :global(dd) {
    min-width: 0;
    margin: 0;
  }
  .bangumi-rating {
    min-width: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }
  .bangumi-score {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .bangumi-score strong {
    color: var(--accent);
    font-size: 1.9rem;
    font-weight: 650;
    line-height: 1.2;
  }
  .bangumi-score > span {
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }
  .bangumi-votes {
    margin-top: 0.25rem;
    font-size: 0.65rem;
  }
  .bangumi-chart {
    display: flex;
    align-items: end;
    gap: 3px;
    height: 78px;
    margin-top: 0.75rem;
  }
  .bangumi-column {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    height: 100%;
  }
  .bangumi-track {
    display: flex;
    align-items: end;
    width: 100%;
    height: 60px;
  }
  .bangumi-track > span {
    width: 100%;
    border-radius: 2px 2px 0 0;
    background: color-mix(in srgb, var(--accent) 65%, var(--muted));
  }
  .bangumi-tick {
    color: var(--muted-foreground);
    font-size: 0.6rem;
    line-height: 18px;
  }
  .bangumi-description {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .bangumi-summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted-foreground);
    white-space: pre-line;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow-wrap: anywhere;
  }
  .bangumi-summary.is-expanded {
    display: block;
    -webkit-line-clamp: unset;
  }
  .bangumi-summary-toggle {
    margin-top: 0.35rem;
    padding: 0.2rem 0;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
  }
  .bangumi-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--muted) 25%, var(--background));
  }
  .bangumi-personal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.65rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .bangumi-personal strong {
    color: var(--accent);
    font-weight: 600;
  }
  .bangumi-card [hidden] {
    display: none;
  }
  @media (max-width: 540px) {
    .bangumi-body {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 0.85rem;
      padding: 0.85rem;
    }
    .bangumi-title {
      font-size: 0.9rem;
    }
    .bangumi-meta {
      font-size: 0.75rem;
    }
    .bangumi-rating {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(140px, 1fr);
      gap: 0 1rem;
      align-items: center;
      padding: 0.75rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .bangumi-chart {
      grid-column: 2;
      grid-row: 1 / 3;
      width: 100%;
      margin: 0;
    }
    .bangumi-votes {
      align-self: start;
    }
    .bangumi-header,
    .bangumi-footer {
      padding-inline: 0.85rem;
    }
  }
</style>
