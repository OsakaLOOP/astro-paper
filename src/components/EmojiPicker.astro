---
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<div class="emoji-picker" data-emoji-picker>
  <button
    type="button"
    class="emoji-trigger"
    data-emoji-trigger
    aria-expanded="false"
    aria-controls="emoji-panel"
    aria-label={t.comments.emoji.insert}
  >
    {t.comments.emoji.trigger}
  </button>
  <div
    class="emoji-panel"
    data-emoji-panel
    id="emoji-panel"
    role="dialog"
    aria-label={t.comments.emoji.picker}
    hidden
  >
    <div
      class="emoji-tabs"
      data-emoji-tabs
      role="tablist"
      aria-label={t.comments.emoji.groups}
    >
    </div>
    <div class="emoji-contents" data-emoji-contents></div>
    <div
      class="emoji-swipe-hint"
      data-emoji-swipe-hint
      aria-hidden="true"
      hidden
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="m15 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
    </div>
    <p class="emoji-empty" data-emoji-empty hidden>
      {t.comments.emoji.unavailable}
    </p>
  </div>
</div>
