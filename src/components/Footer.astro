---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span
        aria-label="Copyleft icon"
        style={{ display: "inline-block", transform: "rotateY(180deg)" }}
        >&copy;</span
      >
      <span> Loopo {currentYear} CC-BY-NC 4.0</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span
        >{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://beian.miit.gov.cn/"
        >
          苏ICP备2025213499号-2
        </LinkButton>{" "}</span
      >
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span
        >{" "}
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://icp.gov.moe/?keyword=20269164"
        >
          萌ICP备20269164号
        </LinkButton>{" "}</span
      >
    </div>
  </div>
</footer>
