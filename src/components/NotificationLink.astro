---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import { blogApiOrigin as api } from "@/scripts/blog-api";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const accountPath = `${getRelativeLocaleUrl(locale, "account")}#notifications`;
const accountUrl = new URL(accountPath, Astro.url).href;
const loginUrl = `${api}/blog/auth/login?returnTo=${encodeURIComponent(accountUrl)}`;
---

<a
  class="notification-link"
  data-notification-link
  data-api={api}
  data-account-url={accountPath}
  data-login-url={loginUrl}
  data-label-manage={t.footer.manageNotifications}
  href={loginUrl}
>
  {t.footer.logInToManageNotifications}
</a>

<script>
  const initialized = new WeakSet<HTMLAnchorElement>();

  async function initNotificationLink() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      "[data-notification-link]"
    )) {
      if (initialized.has(link)) continue;
      initialized.add(link);
      try {
        const response = await fetch(`${link.dataset.api}/blog/auth/me`, {
          credentials: "include",
          cache: "no-store",
        });
        if (!response.ok) continue;
        link.href = link.dataset.accountUrl!;
        link.textContent = link.dataset.labelManage ?? link.textContent;
      } catch {}
    }
  }

  document.addEventListener("astro:page-load", initNotificationLink);
  initNotificationLink();
</script>
