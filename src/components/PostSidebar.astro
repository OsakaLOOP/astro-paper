---
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import ArticleStats from "@/components/ArticleStats.astro";
import { useTranslations } from "@/i18n";
import { getTagCounts, getUniqueTags } from "@/utils/getUniqueTags";
import { postFilter } from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  title: string;
  headings: MarkdownHeading[];
  postTags: string[];
  pubDatetime: Date;
  modDatetime?: Date | null;
  timezone?: string;
  postSlug: string;
};

const {
  title,
  headings,
  postTags,
  pubDatetime,
  modDatetime,
  timezone,
  postSlug,
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
const posts = (await getCollection("posts")).filter(postFilter);
const counts = getTagCounts(posts);
const currentTags = new Set(postTags.map(slugifyStr));
const tags = getUniqueTags(posts)
  .map(tag => ({
    ...tag,
    count: counts.get(tag.tag) ?? 0,
    highlighted: currentTags.has(tag.tag),
  }))
  .sort(
    (a, b) =>
      Number(b.highlighted) - Number(a.highlighted) ||
      b.count - a.count ||
      a.tag.localeCompare(b.tag)
  );
const tocHeadings = headings.filter(
  heading => heading.depth >= 2 && heading.depth <= 4 && heading.slug
);
const firstDepth = Math.min(...tocHeadings.map(heading => heading.depth));
const numberedHeadingPattern = /^\s*(?:\d+(?:[.．]\d+)+|\d+[.．、)）])\s*/;
let sectionNumber = 0;
---

<aside
  class="contents lg:sticky lg:top-6 lg:block lg:min-w-0 lg:space-y-8 lg:self-start"
>
  <section
    id="post-sidebar-summary"
    class="post-sidebar-summary hidden lg:block"
    aria-label={title}
  >
    <div
      class="post-sidebar-summary__content"
      data-visible="false"
      aria-hidden="true"
    >
      <p
        class="text-accent m-0 text-[1.125rem] leading-snug font-bold wrap-break-word"
      >
        {title}
      </p>
      <div class="mt-1.5 flex items-center gap-2 whitespace-nowrap">
        <Datetime {pubDatetime} {modDatetime} {timezone} size="xs" />
        <ArticleStats slug={postSlug} />
      </div>
    </div>
  </section>

  {
    tocHeadings.length > 0 && (
      <section class="order-1 lg:order-none">
        <h2 class="border-border mb-3 border-b pb-2 text-sm font-semibold">
          {t.post.tableOfContents}
        </h2>
        <div class="toc-clip relative">
          <div id="toc-twin-tails" class="toc-twin-tails" aria-hidden="true">
            {["left", "right"].map(side => (
              <span class={`toc-twin-tail toc-twin-tail--${side}`}>
                <svg
                  class="toc-twin-tie"
                  viewBox="0 0 112 112"
                  fill="none"
                  aria-hidden="true"
                >
                  <defs>
                    <clipPath id={`toc-tie-rear-${side}`}>
                      <path
                        d="M -8 -8 H 144 V 144 H -8 Z M 21 56 H 81 V 144 H 21 Z"
                        clip-rule="evenodd"
                      />
                    </clipPath>
                  </defs>
                  {/* 上边 112、下边 104、高 16；下边居中，再整体旋转 45°。 */}
                  {[
                    {
                      d: "M 4 72 L 0 56 L 112 56 L 108 72 Z",
                      clip: `url(#toc-tie-rear-${side})`,
                    },
                    {
                      d: "M 4 72 L 0 56 L 112 56 L 108 72",
                      clip: undefined,
                    },
                  ].map(({ d, clip }) => (
                    <g clip-path={clip}>
                      <g transform="translate(0 10.03) rotate(45 56 64)">
                        <path d={d} stroke="#171219" stroke-width="8" />
                        <path d={d} stroke="#ce20a5" stroke-width="2" />
                      </g>
                    </g>
                  ))}
                </svg>
              </span>
            ))}
          </div>
          <nav
            id="post-toc"
            aria-label={t.post.tableOfContents}
            class="max-h-48 overflow-y-auto px-2 pt-2 lg:max-h-[min(55vh,36rem)]"
          >
            <div id="toc-track" class="relative py-1">
              <span id="toc-focus" class="toc-focus" aria-hidden="true" />
              <ol class="relative space-y-0.5 pt-10">
                {tocHeadings.map(heading => {
                  const level = heading.depth - firstDepth;
                  const hasOwnNumber = numberedHeadingPattern.test(
                    heading.text
                  );
                  if (level === 0) sectionNumber += 1;
                  const marker = hasOwnNumber
                    ? null
                    : level === 0
                      ? sectionNumber
                      : level === 1
                        ? "•"
                        : "·";
                  return (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        data-heading-id={heading.slug}
                        data-depth={heading.depth}
                        class:list={[
                          "toc-link text-muted-foreground hover:text-foreground flex min-w-0 items-start gap-2 px-2 py-1.5 text-sm leading-snug transition-colors",
                          level === 0 ? "ps-2" : level === 1 ? "ps-5" : "ps-8",
                        ]}
                      >
                        {marker !== null && (
                          <span
                            class="text-muted-foreground mt-px w-4 shrink-0 text-center text-xs"
                            aria-hidden="true"
                          >
                            {marker}
                          </span>
                        )}
                        <span class="min-w-0 wrap-break-word">
                          {heading.text}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          </nav>
        </div>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class="order-3 lg:order-none">
        <h2 class="border-border mb-3 border-b pb-2 text-sm font-semibold">
          {t.nav.tags}
        </h2>
        <ul class="flex flex-wrap gap-x-3 gap-y-3">
          {tags.map(({ tag, tagName, count, highlighted }) => (
            <Tag {tag} {tagName} {count} {highlighted} size="sm" />
          ))}
        </ul>
      </section>
    )
  }
</aside>

<style>
  .post-sidebar-summary {
    position: relative;
    min-height: 3.5rem;
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .post-sidebar-summary__content {
    transform: translateY(0.75rem);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 260ms ease,
      visibility 0s linear 420ms;
  }

  .post-sidebar-summary__content[data-visible="true"] {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    transition-delay: 0ms;
  }

  .post-sidebar-summary__content :global(.article-stats) {
    font-size: 0.7rem;
  }

  .post-sidebar-summary__content :global(.article-stats svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-sidebar-summary__content {
      transition: opacity 0.01ms linear;
    }
  }

  .toc-link[data-visible="true"] {
    color: var(--color-highlight-text);
  }

  .toc-link[data-visible="true"] > span:first-child {
    color: var(--color-highlight-text);
  }

  .toc-focus {
    position: absolute;
    inset-inline: 4px;
    top: 0;
    height: var(--focus-height, 0px);
    transform: translateY(var(--focus-y, 0px));
    border: 2px dashed var(--color-highlight);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
    z-index: 0;
  }

  .toc-focus::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: var(--progress-height, 0px);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-highlight) 44%, transparent) 0%,
      color-mix(in srgb, var(--color-highlight) 16%, transparent) 46%,
      color-mix(in srgb, var(--color-highlight) 2%, transparent) 100%
    );
    pointer-events: none;
  }

  #toc-track > ol {
    position: relative;
    z-index: 2;
  }

  .toc-twin-tails {
    position: absolute;
    inset-inline: 12px;
    top: 0;
    transform: translateY(var(--tail-top, 0px));
    pointer-events: none;
    z-index: 1;
  }

  .toc-clip {
    clip-path: inset(-0.75rem 0 0 0);
  }

  .toc-twin-tail {
    --tail-color: var(--color-highlight);
    position: absolute;
    top: 0;
    width: 20%;
    height: var(--tail-progress, 36px);
  }

  .toc-twin-tail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60%;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--tail-color) 34%, transparent),
      color-mix(in srgb, var(--tail-color) 27%, transparent) 62%,
      color-mix(in srgb, var(--tail-color) 23%, transparent)
    );
  }

  .toc-twin-tail--left {
    left: 0;
  }

  .toc-twin-tail--left::before {
    left: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), 82% 100%, 0 100%);
  }

  .toc-twin-tail--right {
    right: 0;
  }

  .toc-twin-tail--right::before {
    right: 0;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 18% 100%, 0 calc(100% - 10px));
  }

  .toc-twin-tie {
    position: absolute;
    top: 0;
    left: -21%;
    width: 112%;
    height: auto;
    display: block;
    overflow: visible;
    transform: translateY(-50%);
  }

  .toc-twin-tail--right .toc-twin-tie {
    left: auto;
    right: -21%;
    transform: translateY(-50%) scaleX(-1);
  }

  .toc-focus[data-active="true"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-focus {
      transition: none;
    }
  }
</style>

<script>
  let removeListeners = () => {};
  let removeSummaryListeners = () => {};

  function initSidebarSummary() {
    removeSummaryListeners();
    const summary = document.querySelector<HTMLElement>(
      "#post-sidebar-summary"
    );
    const content = summary?.querySelector<HTMLElement>(
      ".post-sidebar-summary__content"
    );
    const header = document.getElementById("post-header");
    if (!summary || !content || !header) return;

    let frame = 0;
    const update = () => {
      frame = 0;
      const headerHidden = header.getBoundingClientRect().bottom <= 0;
      content.dataset.visible = String(headerHidden);
      content.setAttribute("aria-hidden", String(!headerHidden));
    };
    const scheduleUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    removeSummaryListeners = () => {
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      cancelAnimationFrame(frame);
    };
  }

  function initTableOfContents() {
    removeListeners();
    const nav = document.getElementById("post-toc");
    const track = document.getElementById("toc-track");
    const focus = document.getElementById("toc-focus");
    const twinTails = document.getElementById("toc-twin-tails");
    const article = document.getElementById("article");
    if (!nav || !track || !focus || !twinTails || !article) return;

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>("[data-heading-id]")
    );
    const sections = links.flatMap(link => {
      const heading = document.getElementById(link.dataset.headingId ?? "");
      return heading && article.contains(heading)
        ? [{ link, heading, depth: Number(link.dataset.depth) }]
        : [];
    });

    let frame = 0;
    let focusFrame = 0;
    let focusTop = 0;
    let focusBottom = 0;
    let progressTop = 0;
    let progressOrigin = 0;
    let targetTop = 0;
    let targetBottom = 0;
    let targetProgressTop = 0;
    let targetProgressOrigin = 0;
    let trackOffset = 0;
    const paintTails = () => {
      twinTails.style.setProperty(
        "--tail-top",
        `${trackOffset + focusTop - nav.scrollTop}px`
      );
      // 发束末端始终领先进度 36px。
      const tailHeight = Math.max(0, progressTop - focusTop + 36);
      twinTails.style.setProperty("--tail-progress", `${tailHeight}px`);
    };
    const paintFocus = () => {
      const origin = Math.max(focusTop, progressOrigin);
      const progressHeight = Math.max(
        0,
        Math.min(progressTop, focusBottom) - focusTop
      );
      focus.style.setProperty("--focus-y", `${focusTop}px`);
      focus.style.setProperty("--focus-height", `${focusBottom - focusTop}px`);
      focus.style.setProperty(
        "--progress-height",
        `${progressTop <= origin ? 0 : progressHeight}px`
      );
      paintTails();
    };
    const animateFocus = () => {
      focusTop += (targetTop - focusTop) * 0.22;
      focusBottom += (targetBottom - focusBottom) * 0.22;
      progressTop += (targetProgressTop - progressTop) * 0.22;
      progressOrigin += (targetProgressOrigin - progressOrigin) * 0.22;
      if (
        Math.abs(targetTop - focusTop) < 0.5 &&
        Math.abs(targetBottom - focusBottom) < 0.5 &&
        Math.abs(targetProgressTop - progressTop) < 0.5 &&
        Math.abs(targetProgressOrigin - progressOrigin) < 0.5
      ) {
        focusTop = targetTop;
        focusBottom = targetBottom;
        progressTop = targetProgressTop;
        progressOrigin = targetProgressOrigin;
        focusFrame = 0;
      } else {
        focusFrame = requestAnimationFrame(animateFocus);
      }
      paintFocus();
    };
    const moveFocus = (
      top: number,
      bottom: number,
      progress: number,
      origin: number
    ) => {
      targetTop = top;
      targetBottom = bottom;
      targetProgressTop = progress;
      targetProgressOrigin = origin;
      if (
        focus.dataset.active !== "true" ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        cancelAnimationFrame(focusFrame);
        focusFrame = 0;
        focusTop = top;
        focusBottom = bottom;
        progressTop = progress;
        progressOrigin = origin;
        paintFocus();
      } else if (!focusFrame) {
        focusFrame = requestAnimationFrame(animateFocus);
      }
      focus.dataset.active = "true";
    };
    const getProgressPosition = () => {
      const trackTop = track.getBoundingClientRect().top;
      const scrollTop = window.scrollY;
      let index = 0;
      while (
        index < sections.length - 1 &&
        sections[index + 1].heading.getBoundingClientRect().top <= 0
      ) {
        index += 1;
      }

      const current = sections[index];
      const next = sections[index + 1];
      const currentHeadingTop =
        scrollTop + current.heading.getBoundingClientRect().top;
      const nextHeadingTop = next
        ? scrollTop + next.heading.getBoundingClientRect().top
        : scrollTop + article.getBoundingClientRect().bottom;
      const currentLinkTop =
        current.link.getBoundingClientRect().top - trackTop;
      const nextLinkTop = next
        ? next.link.getBoundingClientRect().top - trackTop
        : track.getBoundingClientRect().height;
      const sectionHeight = Math.max(1, nextHeadingTop - currentHeadingTop);
      const ratio = Math.min(
        1,
        Math.max(0, (scrollTop - currentHeadingTop) / sectionHeight)
      );

      return currentLinkTop + (nextLinkTop - currentLinkTop) * ratio;
    };
    const update = () => {
      frame = 0;
      const viewportTop = 0;
      const viewportBottom = window.innerHeight;
      const articleBottom = article.getBoundingClientRect().bottom;

      const visible = sections.map((section, index) => {
        const next = sections[index + 1];
        const top = section.heading.getBoundingClientRect().top;
        const bottom =
          next?.heading.getBoundingClientRect().top ?? articleBottom;
        return top < viewportBottom && bottom > viewportTop;
      });

      for (let index = sections.length - 1; index >= 0; index--) {
        const firstChild = sections[index + 1];
        if (firstChild?.depth > sections[index].depth && visible[index + 1]) {
          visible[index] = true;
        }
        sections[index].link.dataset.visible = String(visible[index]);
      }

      const activeLinks = sections
        .filter((_, index) => visible[index])
        .map(section => section.link);
      if (activeLinks.length === 0) {
        focus.dataset.active = "false";
        cancelAnimationFrame(focusFrame);
        focusFrame = 0;
        return;
      }

      const navRect = nav.getBoundingClientRect();
      const trackRect = track.getBoundingClientRect();
      trackOffset = trackRect.top - navRect.top + nav.scrollTop;
      twinTails.style.width = `${trackRect.width - 8}px`;
      const firstRect = activeLinks[0].getBoundingClientRect();
      const lastRect =
        activeLinks[activeLinks.length - 1].getBoundingClientRect();
      moveFocus(
        Math.max(0, firstRect.top - trackRect.top - 4),
        lastRect.bottom - trackRect.top + 4,
        getProgressPosition(),
        firstRect.top - trackRect.top
      );
      const activeHeight = lastRect.bottom - firstRect.top;
      let shift = 0;
      if (activeHeight > nav.clientHeight || firstRect.top < navRect.top + 8) {
        shift = firstRect.top - navRect.top - 8;
      } else if (lastRect.bottom > navRect.bottom - 8) {
        shift = lastRect.bottom - navRect.bottom + 8;
      }
      if (Math.abs(shift) > 2) {
        nav.scrollTo({ top: nav.scrollTop + shift, behavior: "smooth" });
      }
    };
    const scheduleUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    nav.addEventListener("scroll", paintTails, { passive: true });
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    removeListeners = () => {
      nav.removeEventListener("scroll", paintTails);
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      cancelAnimationFrame(frame);
      cancelAnimationFrame(focusFrame);
    };
  }

  const initPostSidebar = () => {
    initSidebarSummary();
    initTableOfContents();
  };

  document.addEventListener("astro:page-load", initPostSidebar);
</script>
