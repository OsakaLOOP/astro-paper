---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  transitionName?: boolean;
  count?: number;
  highlighted?: boolean;
};

const {
  tag,
  tagName,
  size = "lg",
  transitionName = true,
  count,
  highlighted = false,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={transitionName ? tag : undefined}
    class:list={[
      "flex items-center gap-0.5",
      "border-b-2 transition-transform hover:-translate-y-0.5",
      highlighted
        ? "border-transparent font-semibold"
        : "border-foreground border-dashed",
      highlighted
        ? "hover:text-highlight"
        : "hover:border-accent hover:text-accent",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    {
      highlighted ? (
        <span class="decoration-highlight underline decoration-wavy decoration-2 underline-offset-4 [text-decoration-skip-ink:none]">
          #{tagName}
          {count !== undefined && (
            <sup class="text-muted-foreground text-xs">{count}</sup>
          )}
        </span>
      ) : (
        <>
          <IconHash
            class:list={[
              "opacity-80",
              { "size-5": size === "lg" },
              { "size-4": size === "sm" },
            ]}
          />
          {tagName}
          {count !== undefined && (
            <sup class="text-muted-foreground text-xs">{count}</sup>
          )}
        </>
      )
    }
  </a>
</li>
