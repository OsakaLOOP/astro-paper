---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";

const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
const locale = Astro.currentLocale ?? config.site.lang;
const posts = (await getCollection("posts")).filter(postFilter).map(post => ({
  slug: getPostSlug(post.id, post.filePath).replace(/^\/+|\/+$/g, ""),
  title: post.data.title,
  url: getPostUrl(post.id, post.filePath, locale),
}));
---

<Layout
  title="Account | Loopo:443"
  description="Manage your profile and notification preferences."
>
  <Header />
  <main
    id="main-content"
    class="account-page app-layout"
    data-account-api={api}
    data-account-posts={JSON.stringify(posts)}
    data-account-posts-base={getRelativeLocaleUrl(locale, "posts/")}
  >
    <div class="account-header">
      <h1 class="text-2xl font-semibold sm:text-3xl">Account</h1>
    </div>
    <p class="account-muted" data-state>Loading your account…</p>
    <section class="account-section" data-profile hidden>
      <h2>Profile</h2><label class="account-field"
        >Display name<input data-name maxlength="120" /></label
      ><label class="account-field"
        >Website<input
          data-website
          type="url"
          maxlength="500"
          placeholder="https://example.com"
        /></label
      ><p class="account-email account-muted">
        <span>Email</span><span data-email></span>
      </p><button class="comment-submit account-save" data-save
        >Save changes</button
      >
    </section>
    <section class="account-section" data-notifications hidden>
      <h2>Notifications</h2><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-global /><span
            class="comment-check"
            aria-hidden="true"></span><span
            >Email me about comments I follow</span
          ></label
        >
      </div><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-auto-comments /><span
            class="comment-check"
            aria-hidden="true"></span><span
            >Automatically follow an article when I leave my first comment</span
          ></label
        >
      </div><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-content-notifications /><span
            class="comment-check"
            aria-hidden="true"></span><span
            >Email me about new articles and content updates</span
          ></label
        >
      </div><div data-subscriptions></div>
    </section>
    <section class="account-section" data-security hidden>
      <h2>Security</h2><p class="account-muted">
        Password, email verification, and two-factor authentication are managed
        by SM.
      </p><a class="auth-name" data-security-link>Open SM security settings ↗</a
      >
    </section>
  </main>
  <Footer />
</Layout>
<script>
  function initAccountPage() {
    const page = document.querySelector<HTMLElement>("[data-account-api]");
    if (!page || page.dataset.accountInitialized) return;
    page.dataset.accountInitialized = "true";
    const accountPage = page;
    const posts = new Map<string, { slug: string; title: string; url: string }>(
      JSON.parse(page.dataset.accountPosts ?? "[]").map(
        (post: { slug: string; title: string; url: string }) => [
          post.slug,
          post,
        ]
      )
    );
    const api = page.dataset.accountApi!,
      state = page.querySelector<HTMLElement>("[data-state]")!;
    const profile = page.querySelector<HTMLElement>("[data-profile]")!,
      notifications = page.querySelector<HTMLElement>("[data-notifications]")!,
      security = page.querySelector<HTMLElement>("[data-security]")!;
    const name = page.querySelector<HTMLInputElement>("[data-name]")!,
      website = page.querySelector<HTMLInputElement>("[data-website]")!,
      email = page.querySelector<HTMLElement>("[data-email]")!,
      global = page.querySelector<HTMLInputElement>("[data-global]")!,
      autoComments = page.querySelector<HTMLInputElement>(
        "[data-auto-comments]"
      )!,
      contentNotifications = page.querySelector<HTMLInputElement>(
        "[data-content-notifications]"
      )!,
      subscriptions = page.querySelector<HTMLElement>("[data-subscriptions]")!;
    const esc = (value: unknown) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]!
      );
    async function load() {
      const response = await fetch(`${api}/blog/account`, {
        credentials: "include",
      });
      if (response.status === 401) {
        state.innerHTML = `<a class="auth-name" href="${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href)}">Log in to manage your account</a>`;
        return;
      }
      if (!response.ok)
        throw new Error(`Account request failed: ${response.status}`);
      const data = await response.json();
      state.hidden = true;
      profile.hidden = notifications.hidden = security.hidden = false;
      name.value = data.user.name;
      website.value = data.user.website_url ?? "";
      email.textContent = data.user.email;
      global.checked = data.notifications_enabled;
      autoComments.checked = data.auto_subscribe_comments;
      contentNotifications.checked = data.content_notifications_enabled;
      subscriptions.innerHTML = data.subscriptions.length
        ? data.subscriptions
            .map((item: { post_slug: string }) => {
              const slug = item.post_slug.replace(/^\/+|\/+$/g, "");
              const post = posts.get(slug);
              const path =
                post?.url ??
                `${accountPage.dataset.accountPostsBase!.replace(/\/+$/, "")}/${slug.split("/").map(encodeURIComponent).join("/")}/`;
              const title = post?.title ?? slug;
              return `<div class="account-row account-subscription"><a class="account-subscription-link" href="${esc(path)}#comments"><span class="account-subscription-title">${esc(title)}</span><span class="account-subscription-path">${esc(path)}</span></a><button class="comment-action" data-remove="${esc(item.post_slug)}">Remove</button></div>`;
            })
            .join("")
        : `<p class="account-muted">No article subscriptions yet.</p>`;
      accountPage.querySelector<HTMLAnchorElement>(
        "[data-security-link]"
      )!.href = "https://auth.loopo.cc/sign-in";
    }
    async function update(body: object) {
      await fetch(`${api}/blog/account`, {
        method: "PATCH",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
          Origin: location.origin,
        },
        body: JSON.stringify(body),
      });
    }
    page
      .querySelector("[data-save]")
      ?.addEventListener("click", () =>
        update({ name: name.value.trim(), website_url: website.value.trim() })
      );
    global.addEventListener(
      "change",
      () => void update({ notifications_enabled: global.checked })
    );
    autoComments.addEventListener(
      "change",
      () => void update({ auto_subscribe_comments: autoComments.checked })
    );
    contentNotifications.addEventListener(
      "change",
      () =>
        void update({
          content_notifications_enabled: contentNotifications.checked,
        })
    );
    subscriptions.addEventListener("click", async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-remove]"
      );
      if (!button) return;
      await fetch(
        `${api}/blog/account/subscriptions/${encodeURIComponent(button.dataset.remove!)}`,
        {
          method: "PUT",
          credentials: "include",
          headers: {
            "Content-Type": "application/json",
            Origin: location.origin,
          },
          body: JSON.stringify({ enabled: false }),
        }
      );
      await load();
    });
    load().catch(() => {
      state.textContent = "Account is temporarily unavailable.";
    });
  }
  document.addEventListener("astro:page-load", initAccountPage);
  initAccountPage();
</script>
