---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { blogApiOrigin } from "@/scripts/blog-api";
import { useTranslations } from "@/i18n";

const api = blogApiOrigin;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

/** Strings the client script needs, serialised once for the whole page. */
const labels = {
  logInToManage: t.account.logInToManage,
  unavailable: t.account.unavailable,
  subscriptionsEmpty: t.account.subscriptionsEmpty,
  remove: t.account.remove,
  saved: t.account.saved,
  saveFailed: t.account.saveFailed,
};
const posts = (await getCollection("posts")).filter(postFilter).map(post => ({
  slug: getPostSlug(post.id, post.filePath).replace(/^\/+|\/+$/g, ""),
  title: post.data.title,
  url: getPostUrl(post.id, post.filePath, locale),
}));
---

<Layout
  title={`${t.account.title} | ${config.site.title}`}
  description={t.account.description}
  noindex
>
  <Header />
  <main
    id="main-content"
    class="account-page app-layout"
    data-account-api={api}
    data-account-posts={JSON.stringify(posts)}
    data-account-posts-base={getRelativeLocaleUrl(locale, "posts/")}
    data-account-labels={JSON.stringify(labels)}
    data-account-security-url={config.site.securityUrl}
  >
    <div class="account-header">
      <h1 class="text-2xl font-semibold sm:text-3xl">{t.account.title}</h1>
    </div>
    <p class="account-muted" data-state>{t.account.loading}</p>
    <section class="account-section" data-profile hidden>
      <h2>{t.account.profile}</h2><label class="account-field"
        >{t.account.displayName}<input data-name maxlength="120" /></label
      ><label class="account-field"
        >{t.account.website}<input
          data-website
          type="url"
          maxlength="500"
          placeholder="https://example.com"
        /></label
      ><p class="account-email account-muted">
        <span>{t.account.email}</span><span data-email></span>
      </p><p class="account-feedback" data-feedback role="status" hidden>
      </p><button class="comment-submit account-save" data-save
        >{t.account.save}</button
      >
    </section>
    <section
      id="notifications"
      class="account-section"
      data-notifications
      hidden
    >
      <h2>{t.account.notifications}</h2><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-global /><span
            class="comment-check"
            aria-hidden="true"></span><span>{t.account.notifyComments}</span
          ></label
        >
      </div><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-auto-comments /><span
            class="comment-check"
            aria-hidden="true"></span><span>{t.account.autoSubscribe}</span
          ></label
        >
      </div><div class="account-row">
        <label class="comment-subscribe"
          ><input type="checkbox" data-content-notifications /><span
            class="comment-check"
            aria-hidden="true"></span><span>{t.account.notifyContent}</span
          ></label
        >
      </div><div data-subscriptions></div>
    </section>
    <section class="account-section" data-security hidden>
      <h2>{t.account.security}</h2><p class="account-muted">
        {t.account.securityDesc}
      </p><a class="auth-name" data-security-link>{t.account.securityLink}</a>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  import {
    BlogRequestError,
    describeBlogError,
    requestBlogApi,
  } from "@/scripts/blog-api";

  function initAccountPage() {
    const page = document.querySelector<HTMLElement>("[data-account-api]");
    if (!page || page.dataset.accountInitialized) return;
    page.dataset.accountInitialized = "true";
    const accountPage = page;
    const labels = JSON.parse(page.dataset.accountLabels ?? "{}") as Record<
      string,
      string
    >;
    const securityUrl = page.dataset.accountSecurityUrl ?? "";
    const posts = new Map<string, { slug: string; title: string; url: string }>(
      JSON.parse(page.dataset.accountPosts ?? "[]").map(
        (post: { slug: string; title: string; url: string }) => [
          post.slug,
          post,
        ]
      )
    );
    const api = page.dataset.accountApi!,
      state = page.querySelector<HTMLElement>("[data-state]")!;
    const profile = page.querySelector<HTMLElement>("[data-profile]")!,
      notifications = page.querySelector<HTMLElement>("[data-notifications]")!,
      security = page.querySelector<HTMLElement>("[data-security]")!;
    const name = page.querySelector<HTMLInputElement>("[data-name]")!,
      website = page.querySelector<HTMLInputElement>("[data-website]")!,
      email = page.querySelector<HTMLElement>("[data-email]")!,
      global = page.querySelector<HTMLInputElement>("[data-global]")!,
      autoComments = page.querySelector<HTMLInputElement>(
        "[data-auto-comments]"
      )!,
      contentNotifications = page.querySelector<HTMLInputElement>(
        "[data-content-notifications]"
      )!,
      subscriptions = page.querySelector<HTMLElement>("[data-subscriptions]")!;
    const feedback = page.querySelector<HTMLElement>("[data-feedback]")!;
    const showFeedback = (message: string, ok: boolean) => {
      feedback.textContent = message;
      feedback.dataset.state = ok ? "ok" : "error";
      feedback.hidden = false;
    };
    const clearFeedback = () => {
      feedback.hidden = true;
      feedback.textContent = "";
      delete feedback.dataset.state;
    };
    const esc = (value: unknown) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]!
      );
    type AccountPayload = {
      user: { name: string; website_url: string | null; email: string };
      notifications_enabled: boolean;
      auto_subscribe_comments: boolean;
      content_notifications_enabled: boolean;
      subscriptions: { post_slug: string }[];
    };
    async function load() {
      let data: AccountPayload | undefined;
      try {
        data = await requestBlogApi<AccountPayload>(`${api}/blog/account`);
      } catch (error) {
        if (error instanceof BlogRequestError && error.status === 401) {
          state.innerHTML = `<a class="auth-name" href="${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href)}">${esc(labels.logInToManage)}</a>`;
          return;
        }
        throw error;
      }
      if (!data?.user) throw new BlogRequestError("response");
      state.hidden = true;
      profile.hidden = notifications.hidden = security.hidden = false;
      name.value = data.user.name;
      website.value = data.user.website_url ?? "";
      email.textContent = data.user.email;
      global.checked = data.notifications_enabled;
      autoComments.checked = data.auto_subscribe_comments;
      contentNotifications.checked = data.content_notifications_enabled;
      subscriptions.innerHTML = data.subscriptions.length
        ? data.subscriptions
            .map((item: { post_slug: string }) => {
              const slug = item.post_slug.replace(/^\/+|\/+$/g, "");
              const post = posts.get(slug);
              const path =
                post?.url ??
                `${accountPage.dataset.accountPostsBase!.replace(/\/+$/, "")}/${slug.split("/").map(encodeURIComponent).join("/")}/`;
              const title = post?.title ?? slug;
              return `<div class="account-row account-subscription"><a class="account-subscription-link" href="${esc(path)}#comments"><span class="account-subscription-title">${esc(title)}</span><span class="account-subscription-path">${esc(path)}</span></a><button class="comment-action" data-remove="${esc(item.post_slug)}">${esc(labels.remove)}</button></div>`;
            })
            .join("")
        : `<p class="account-muted">${esc(labels.subscriptionsEmpty)}</p>`;
      const securityLink = accountPage.querySelector<HTMLAnchorElement>(
        "[data-security-link]"
      );
      if (securityUrl && securityLink) securityLink.href = securityUrl;
      else securityLink?.closest("section")?.remove();
      if (location.hash === "#notifications") notifications.scrollIntoView();
    }
    async function update(body: object, silent = false) {
      try {
        await requestBlogApi(`${api}/blog/account`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!silent) showFeedback(labels.saved, true);
        return true;
      } catch (error) {
        if (error instanceof BlogRequestError && error.status === 401) {
          state.hidden = false;
          state.innerHTML = `<a class="auth-name" href="${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href)}">${esc(labels.logInToManage)}</a>`;
          return false;
        }
        showFeedback(`${labels.saveFailed} ${describeBlogError(error)}`, false);
        return false;
      }
    }
    page.querySelector("[data-save]")?.addEventListener("click", () => {
      clearFeedback();
      void update({
        name: name.value.trim(),
        website_url: website.value.trim(),
      });
    });
    global.addEventListener("change", () => {
      void update({ notifications_enabled: global.checked }, true);
    });
    autoComments.addEventListener("change", () => {
      void update({ auto_subscribe_comments: autoComments.checked }, true);
    });
    contentNotifications.addEventListener("change", () => {
      void update(
        { content_notifications_enabled: contentNotifications.checked },
        true
      );
    });
    subscriptions.addEventListener("click", async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-remove]"
      );
      if (!button) return;
      button.disabled = true;
      try {
        await requestBlogApi(
          `${api}/blog/account/subscriptions/${encodeURIComponent(button.dataset.remove!)}`,
          {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ enabled: false }),
          }
        );
        await load();
      } catch (error) {
        showFeedback(`${labels.saveFailed} ${describeBlogError(error)}`, false);
      } finally {
        button.disabled = false;
      }
    });
    load().catch(error => {
      state.textContent = `${labels.unavailable} ${describeBlogError(error)}`;
    });
  }
  document.addEventListener("astro:page-load", initAccountPage);
  initAccountPage();
</script>
