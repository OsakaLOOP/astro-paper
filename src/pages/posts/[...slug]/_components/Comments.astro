---
import EmojiPicker from "@/components/EmojiPicker.astro";

const { postSlug, postTitle } = Astro.props;
const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
const debug = import.meta.env.PUBLIC_COMMENTS_DEBUG === "true";
---

<section
  class="comments"
  id="comments"
  data-comments-api={api}
  data-post={postSlug}
  data-post-title={postTitle}
  data-comments-debug={debug ? "true" : undefined}
>
  <div class="comments-heading">
    <h2>Leave a comment</h2><span class="comments-count" data-count
      >Loading</span
    >
  </div>
  <div class="comments-editor" data-editor hidden>
    <div class="comments-editor-header">
      <div class="comments-tabs">
        <button class="comments-tab" data-tab="write" aria-selected="true"
          >Write</button
        ><button class="comments-tab" data-tab="preview" aria-selected="false"
          >Preview(Markdown)</button
        >
      </div>
      <EmojiPicker />
    </div>
    <textarea
      data-input
      maxlength="2000"
      rows="4"
      placeholder="Leave a comment…"></textarea>
    <div class="comment-preview" data-preview hidden></div>
    <div class="comments-editor-footer">
      <label class="comment-subscribe"
        ><input type="checkbox" data-subscribe /><span
          class="comment-check"
          aria-hidden="true"></span><span
          >Email me about new comments on this article</span
        ></label
      ><button type="button" class="comment-submit" data-submit>Send</button>
    </div>
  </div>
  <div class="comments-login" data-login hidden>
    <span>Log in to join the discussion.</span>
    <a data-login-link>Log in</a>
  </div>
  <p class="comments-error" data-feedback role="alert" hidden></p>
  <div class="comments-list" data-list aria-live="polite">
    <p class="comments-loading">Loading comments…</p>
  </div>
</section>
<script>
  import { marked } from "marked";
  import DOMPurify from "dompurify";
  import {
    BlogRequestError,
    describeBlogError,
    requestBlogApi,
  } from "@/scripts/blog-api";
  import {
    createEmojiIndex,
    splitEmojiText,
    type EmojiItem,
    type EmojiManifest,
  } from "@/utils/emoji";

  let emojiManifestPromise: Promise<EmojiManifest | null> | undefined;
  const loadEmojiManifest = () => {
    if (!emojiManifestPromise) {
      emojiManifestPromise = fetch("/emoji/manifest.json", {
        cache: "force-cache",
      })
        .then(async response => {
          if (!response.ok) return null;
          const manifest = (await response.json()) as EmojiManifest;
          return Array.isArray(manifest.groups) ? manifest : null;
        })
        .catch(() => null);
    }
    return emojiManifestPromise;
  };

  const mounted = new Map<HTMLElement, AbortController>();
  function initComments() {
    const sections = [...document.querySelectorAll<HTMLElement>(".comments")];
    for (const [sectionIndex, section] of sections.entries()) {
      if (mounted.has(section)) continue;
      const lifecycle = new AbortController();
      const listenerOptions = { signal: lifecycle.signal };
      mounted.set(section, lifecycle);
      const api = section.dataset.commentsApi!,
        post = section.dataset.post!,
        list = section.querySelector<HTMLElement>("[data-list]")!,
        editor = section.querySelector<HTMLElement>("[data-editor]")!,
        login = section.querySelector<HTMLElement>("[data-login]")!,
        input = section.querySelector<HTMLTextAreaElement>("[data-input]")!,
        preview = section.querySelector<HTMLElement>("[data-preview]")!,
        count = section.querySelector<HTMLElement>("[data-count]")!,
        subscribe =
          section.querySelector<HTMLInputElement>("[data-subscribe]")!,
        feedback = section.querySelector<HTMLElement>("[data-feedback]")!,
        picker = section.querySelector<HTMLElement>("[data-emoji-picker]")!,
        emojiTrigger = picker.querySelector<HTMLButtonElement>(
          "[data-emoji-trigger]"
        )!,
        emojiPanel = picker.querySelector<HTMLElement>("[data-emoji-panel]")!,
        emojiTabs = picker.querySelector<HTMLElement>("[data-emoji-tabs]")!,
        emojiContents = picker.querySelector<HTMLElement>(
          "[data-emoji-contents]"
        )!,
        emojiEmpty = picker.querySelector<HTMLElement>("[data-emoji-empty]")!,
        emojiSwipeHint = picker.querySelector<HTMLElement>(
          "[data-emoji-swipe-hint]"
        )!;
      const debugEnabled = section.dataset.commentsDebug === "true";
      const startedAt = performance.now();
      let emojiManifest: EmojiManifest | null = null;
      let touchInteraction = window.matchMedia("(hover: none)").matches;
      let activeEmojiGroup = "";
      picker.dataset.touch = String(touchInteraction);
      let emojiIndex: ReadonlyMap<string, EmojiItem> = new Map();
      let rerenderComments: (() => void) | undefined;
      const debugLog = (
        event: string,
        details: Record<string, unknown> = {}
      ) => {
        if (!debugEnabled) return;
        globalThis.console.debug(
          `[comments][${new Date().toISOString()}][+${(performance.now() - startedAt).toFixed(1)}ms] ${event}`,
          { post, ...details }
        );
      };
      debugLog("init", { post });
      const safe = (value: unknown) =>
        String(value ?? "").replace(
          /[&<>"']/g,
          c =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c]!
        );
      const returnTo = new URL(location.href);
      returnTo.hash = "comments";
      section.querySelector<HTMLAnchorElement>("[data-login-link]")!.href =
        `${api}/blog/auth/login?returnTo=${encodeURIComponent(returnTo.href)}`;
      const replyMarker =
        '<span class="comment-reply-marker" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20h-7a4 4 0 0 1-4-4V4"></path><path d="m14 9-5-5-5 5"></path></svg></span>';

      const renderMarkdown = (value: string) => {
        if (!emojiManifest) {
          return DOMPurify.sanitize(
            marked.parse(value, { async: false }) as string,
            {
              USE_PROFILES: { html: true },
            }
          );
        }
        const html = DOMPurify.sanitize(
          marked.parse(value, { async: false }) as string,
          { USE_PROFILES: { html: true } }
        );
        const container = document.createElement("div");
        container.innerHTML = html;
        const walker = document.createTreeWalker(
          container,
          NodeFilter.SHOW_TEXT
        );
        const textNodes: Text[] = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode as Text);
        for (const textNode of textNodes) {
          if (textNode.parentElement?.closest("code, pre")) continue;
          const text = textNode.nodeValue ?? "";
          const parts = splitEmojiText(text, emojiIndex);
          if (parts.length === 1 && typeof parts[0] === "string") continue;
          const fragment = document.createDocumentFragment();
          for (const part of parts) {
            if (typeof part === "string") {
              fragment.append(document.createTextNode(part));
              continue;
            }
            const image = document.createElement("img");
            image.className = "comment-emoji";
            image.src = part.src;
            image.alt = part.alt;
            image.title = part.alt;
            image.draggable = false;
            image.loading = "lazy";
            fragment.append(image);
          }
          textNode.parentNode?.replaceChild(fragment, textNode);
        }
        return container.innerHTML;
      };
      const setEmojiPanelOpen = (open: boolean, restoreFocus = false) => {
        emojiPanel.hidden = !open;
        emojiTrigger.setAttribute("aria-expanded", String(open));
        if (open && !touchInteraction) {
          picker
            .querySelector<HTMLButtonElement>(
              "[data-emoji-content]:not([hidden]) [data-emoji-id]"
            )
            ?.focus({ preventScroll: true });
        } else if (restoreFocus) {
          emojiTrigger.focus({ preventScroll: true });
        }
      };
      let closeTimer: number | undefined;
      const cancelEmojiClose = () => {
        if (closeTimer !== undefined) window.clearTimeout(closeTimer);
        closeTimer = undefined;
      };
      lifecycle.signal.addEventListener("abort", cancelEmojiClose, {
        once: true,
      });
      const scheduleEmojiClose = () => {
        cancelEmojiClose();
        closeTimer = window.setTimeout(() => setEmojiPanelOpen(false), 120);
      };
      const emojiScrollBehavior = (): ScrollBehavior =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth";
      const scrollToEmojiGroup = (behavior: ScrollBehavior) => {
        if (!touchInteraction || emojiPanel.hidden) return;
        const index = emojiManifest?.groups.findIndex(
          group => group.id === activeEmojiGroup
        );
        if (index === undefined || index < 0) return;
        emojiContents.scrollTo({
          left: index * emojiContents.getBoundingClientRect().width,
          behavior,
        });
      };
      const activateEmojiGroup = (groupId: string, scroll = true) => {
        activeEmojiGroup = groupId;
        emojiTabs
          .querySelectorAll<HTMLButtonElement>("[data-emoji-tab]")
          .forEach(tab => {
            const active = tab.dataset.emojiTab === groupId;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
          });
        emojiContents
          .querySelectorAll<HTMLElement>("[data-emoji-content]")
          .forEach(content => {
            const active = content.dataset.emojiContent === groupId;
            content.hidden = !touchInteraction && !active;
            content.inert = touchInteraction && !active;
          });
        const groups = emojiManifest?.groups ?? [];
        const index = groups.findIndex(group => group.id === groupId);
        emojiSwipeHint.hidden = !touchInteraction || groups.length < 2;
        emojiSwipeHint.dataset.atStart = String(index === 0);
        emojiSwipeHint.dataset.atEnd = String(index === groups.length - 1);
        if (!touchInteraction) return;
        if (scroll) scrollToEmojiGroup(emojiScrollBehavior());
        const activeTab = emojiTabs.querySelector<HTMLElement>(
          '[aria-selected="true"]'
        );
        if (activeTab && !emojiPanel.hidden) {
          const tabRect = activeTab.getBoundingClientRect();
          const tabsRect = emojiTabs.getBoundingClientRect();
          if (tabRect.left < tabsRect.left || tabRect.right > tabsRect.right)
            emojiTabs.scrollBy({
              left:
                tabRect.left -
                tabsRect.left -
                (tabsRect.width - tabRect.width) / 2,
              behavior: emojiScrollBehavior(),
            });
        }
      };
      const setEmojiInteraction = (touch: boolean) => {
        cancelEmojiClose();
        if (touchInteraction === touch) return;
        touchInteraction = touch;
        picker.dataset.touch = String(touch);
        activateEmojiGroup(activeEmojiGroup, false);
        if (touch) scrollToEmojiGroup("instant");
        else emojiContents.scrollLeft = 0;
      };
      const renderEmojiPicker = (manifest: EmojiManifest | null) => {
        emojiTabs.replaceChildren();
        emojiContents.replaceChildren();
        emojiEmpty.hidden = Boolean(manifest);
        emojiTrigger.disabled = !manifest;
        if (!manifest) return;
        for (const [index, group] of manifest.groups.entries()) {
          const tab = document.createElement("button");
          tab.type = "button";
          tab.className = "emoji-tab";
          tab.dataset.emojiTab = group.id;
          tab.id = `emoji-tab-${sectionIndex}-${group.id}`;
          tab.setAttribute("role", "tab");
          tab.setAttribute(
            "aria-controls",
            `emoji-content-${sectionIndex}-${group.id}`
          );
          tab.textContent = group.label;
          tab.tabIndex = index === 0 ? 0 : -1;
          emojiTabs.append(tab);

          const content = document.createElement("section");
          content.className = "emoji-content";
          content.dataset.emojiContent = group.id;
          content.id = `emoji-content-${sectionIndex}-${group.id}`;
          content.setAttribute("role", "tabpanel");
          content.setAttribute("aria-labelledby", tab.id);
          content.hidden = index !== 0;
          const grid = document.createElement("div");
          grid.className = "emoji-grid";
          for (const item of group.items) {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "emoji-item";
            button.dataset.emojiId = item.id;
            button.title = item.alt;
            button.setAttribute("aria-label", item.alt);
            const image = document.createElement("img");
            image.src = item.src;
            image.alt = item.alt;
            image.loading = "lazy";
            image.decoding = "async";
            image.draggable = false;
            button.append(image);
            grid.append(button);
          }
          content.append(grid);
          emojiContents.append(content);
        }
        if (manifest.groups[0])
          activateEmojiGroup(manifest.groups[0].id, false);
      };
      const pickerId = `emoji-panel-${sectionIndex}`;
      emojiPanel.id = pickerId;
      emojiTrigger.setAttribute("aria-controls", pickerId);
      emojiTrigger.addEventListener(
        "click",
        () => {
          cancelEmojiClose();
          setEmojiPanelOpen(Boolean(emojiPanel.hidden));
          scrollToEmojiGroup("instant");
        },
        listenerOptions
      );
      picker.addEventListener(
        "pointerenter",
        event => {
          if (
            event.pointerType !== "mouse" ||
            !window.matchMedia("(hover: hover)").matches
          )
            return;
          setEmojiInteraction(false);
          setEmojiPanelOpen(true);
        },
        listenerOptions
      );
      picker.addEventListener(
        "pointerleave",
        event => {
          if (event.pointerType === "mouse" && !touchInteraction)
            scheduleEmojiClose();
        },
        listenerOptions
      );
      picker.addEventListener(
        "pointerdown",
        event => setEmojiInteraction(event.pointerType !== "mouse"),
        { capture: true, ...listenerOptions }
      );
      picker.addEventListener("focusin", cancelEmojiClose, listenerOptions);
      picker.addEventListener(
        "focusout",
        event => {
          if (
            !touchInteraction &&
            !picker.contains(event.relatedTarget as Node | null)
          )
            scheduleEmojiClose();
        },
        listenerOptions
      );
      emojiPanel.addEventListener(
        "pointerenter",
        cancelEmojiClose,
        listenerOptions
      );
      emojiPanel.addEventListener(
        "pointerdown",
        event => event.stopPropagation(),
        listenerOptions
      );
      emojiPanel.addEventListener("wheel", event => event.stopPropagation(), {
        passive: true,
        ...listenerOptions,
      });
      emojiPanel.addEventListener(
        "touchmove",
        event => event.stopPropagation(),
        {
          passive: true,
          ...listenerOptions,
        }
      );
      emojiContents.addEventListener(
        "scroll",
        () => {
          if (!touchInteraction || !emojiContents.clientWidth) return;
          const index = Math.round(
            emojiContents.scrollLeft /
              emojiContents.getBoundingClientRect().width
          );
          const group = emojiManifest?.groups[index];
          if (group && group.id !== activeEmojiGroup)
            activateEmojiGroup(group.id, false);
        },
        { passive: true, ...listenerOptions }
      );
      const emojiResizeObserver = new ResizeObserver(() =>
        scrollToEmojiGroup("instant")
      );
      emojiResizeObserver.observe(emojiContents);
      lifecycle.signal.addEventListener(
        "abort",
        () => emojiResizeObserver.disconnect(),
        { once: true }
      );
      picker.addEventListener(
        "click",
        event => {
          const tab = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-emoji-tab]"
          );
          if (tab) {
            activateEmojiGroup(tab.dataset.emojiTab!);
            return;
          }
          const target = (
            event.target as HTMLElement
          ).closest<HTMLButtonElement>("[data-emoji-id]");
          if (!target) return;
          const start = input.selectionStart ?? input.value.length;
          const end = input.selectionEnd ?? start;
          input.setRangeText(`(${target.dataset.emojiId})`, start, end, "end");
          input.dispatchEvent(new Event("input", { bubbles: true }));
          setEmojiPanelOpen(false);
          input.focus();
        },
        listenerOptions
      );
      picker.addEventListener(
        "keydown",
        event => {
          const tab = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-emoji-tab]"
          );
          if (!tab || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
          const tabs = [
            ...emojiTabs.querySelectorAll<HTMLButtonElement>(
              "[data-emoji-tab]"
            ),
          ];
          const current = tabs.indexOf(tab);
          const next =
            (current + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
            tabs.length;
          event.preventDefault();
          activateEmojiGroup(tabs[next].dataset.emojiTab!);
          tabs[next].focus();
        },
        listenerOptions
      );
      document.addEventListener(
        "keydown",
        event => {
          if (event.key === "Escape" && !emojiPanel.hidden)
            setEmojiPanelOpen(false, true);
        },
        { signal: lifecycle.signal }
      );
      document.addEventListener(
        "pointerdown",
        event => {
          if (!emojiPanel.hidden && !picker.contains(event.target as Node))
            setEmojiPanelOpen(false);
        },
        { signal: lifecycle.signal }
      );

      const showIdentity = (authenticated: boolean) => {
        editor.hidden = !authenticated;
        login.hidden = authenticated;
        debugLog("identity-state", { authenticated });
      };
      const showActionError = (action: string, error: unknown) => {
        if (lifecycle.signal.aborted || !section.isConnected) return;
        if (error instanceof BlogRequestError && error.status === 401)
          showIdentity(false);
        feedback.textContent = `${action} failed. ${describeBlogError(error)}`;
        feedback.hidden = false;
        debugLog("action-error", { action, error: String(error) });
      };
      const clearFeedback = () => {
        feedback.hidden = true;
        feedback.textContent = "";
      };
      const showError = (error: unknown) => {
        if (lifecycle.signal.aborted || !section.isConnected) return;
        rerenderComments = undefined;
        count.textContent = "Unavailable";
        list.innerHTML = `<div class="comments-error" role="alert"><p>Comments could not be loaded. ${safe(describeBlogError(error))}</p><button type="button" class="comment-action comments-retry" data-retry>Try again</button></div>`;
      };
      section.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach(tab =>
        tab.addEventListener(
          "click",
          () => {
            const isPreview = tab.dataset.tab === "preview";
            section
              .querySelectorAll<HTMLButtonElement>("[data-tab]")
              .forEach(item =>
                item.setAttribute("aria-selected", String(item === tab))
              );
            input.hidden = isPreview;
            preview.hidden = !isPreview;
            if (isPreview) preview.innerHTML = renderMarkdown(input.value);
          },
          listenerOptions
        )
      );
      let requestId = 0;
      let requestController: AbortController | null = null;
      const isCurrentRequest = (id: number, controller: AbortController) =>
        !lifecycle.signal.aborted &&
        section.isConnected &&
        requestId === id &&
        requestController === controller;
      async function loadComments(reason = "initial") {
        if (lifecycle.signal.aborted || !section.isConnected) return;
        requestController?.abort();
        const controller = new AbortController();
        const id = ++requestId;
        requestController = controller;
        const requestStarted = performance.now();
        debugLog("comments-request-start", { reason, id });
        if (reason === "initial" || reason === "retry") {
          rerenderComments = undefined;
          list.innerHTML = `<p class="comments-loading">Loading comments…</p>`;
          count.textContent = "Loading";
        }
        try {
          const payload = await requestBlogApi<any>(
            `${api}/blog/comments?post=${encodeURIComponent(post)}`,
            { signal: AbortSignal.any([lifecycle.signal, controller.signal]) }
          );
          if (
            !payload ||
            !Array.isArray(payload.items) ||
            typeof payload.total !== "number"
          )
            throw new BlogRequestError("response");
          if (!isCurrentRequest(id, controller)) return;
          debugLog("comments-response", {
            ms: +(performance.now() - requestStarted).toFixed(1),
            id,
          });
          debugLog("comments-payload", {
            total: payload.total,
            items: payload.items.length,
            viewer: Boolean(payload.viewer),
            id,
          });
          count.textContent = `${payload.total} comments`;
          subscribe.checked =
            payload.subscribed ||
            (!payload.subscription_configured &&
              payload.auto_subscribe_comments);
          showIdentity(Boolean(payload.viewer));
          const items = payload.items as any[];
          const ids = new Set(items.map(item => item.id));
          const byParent = new Map<string | null, any[]>();
          for (const item of items) {
            const key =
              item.parent_id && ids.has(item.parent_id) ? item.parent_id : null;
            byParent.set(key, [...(byParent.get(key) ?? []), item]);
          }
          const renderCommentList = () => {
            const render = (item: any, depth: number): string => {
              const createdAt = new Date(item.created_at);
              const formattedTime = createdAt.toLocaleString(undefined, {
                dateStyle: "medium",
                timeStyle: "short",
              });
              return `<article class="comment${item.parent_id ? " comment--reply" : ""}" style="--comment-depth:${Math.min(depth, 3)}" data-comment-id="${safe(item.id)}" data-comment-body="${safe(item.body)}">${item.parent_id ? replyMarker : ""}<div class="comment-meta"><strong>${item.author_url ? `<a href="${safe(item.author_url)}" target="_blank" rel="noopener noreferrer">${safe(item.author_name)}</a>` : safe(item.author_name)}</strong><time datetime="${createdAt.toISOString()}">${formattedTime}</time></div>${item.deleted_at ? `<p class="account-muted">Comment removed by an admin.</p>` : `<div class="comment-content">${renderMarkdown(item.body)}</div>`}<div class="comment-actions">${item.can_edit ? `<button class="comment-action" data-edit="${safe(item.id)}" data-version="${item.version}">Edit</button>` : ""}${item.can_delete ? `<button class="comment-action" data-delete="${safe(item.id)}">Delete</button>` : ""}${!item.deleted_at ? `<button class="comment-action" data-reply="${safe(item.id)}">Reply</button>` : ""}</div></article>`;
            };
            const ordered: string[] = [];
            const flatten = (item: any, depth: number) => {
              ordered.push(render(item, depth));
              for (const child of byParent.get(item.id) ?? [])
                flatten(child, depth + 1);
            };
            for (const item of byParent.get(null) ?? []) flatten(item, 0);
            list.innerHTML =
              ordered.join("") ||
              `<p class="comments-empty">No comments yet. Be first to share your thoughts.</p>`;
            debugLog("comments-rendered", { items: ordered.length, id });
          };
          rerenderComments = renderCommentList;
          renderCommentList();
        } catch (error) {
          if (controller.signal.aborted || lifecycle.signal.aborted) {
            debugLog("comments-request-aborted", { reason, id });
            return;
          }
          debugLog("comments-request-error", {
            reason,
            id,
            error: String(error),
          });
          if (isCurrentRequest(id, controller)) showError(error);
        } finally {
          if (requestController === controller) requestController = null;
        }
      }
      subscribe.addEventListener(
        "change",
        async () => {
          const enabled = subscribe.checked;
          subscribe.disabled = true;
          clearFeedback();
          try {
            await requestBlogApi(
              `${api}/blog/account/subscriptions/${encodeURIComponent(post)}`,
              {
                method: "PUT",
                signal: lifecycle.signal,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ enabled }),
              }
            );
          } catch (error) {
            if (!lifecycle.signal.aborted) subscribe.checked = !enabled;
            showActionError("Updating subscription", error);
          } finally {
            subscribe.disabled = false;
          }
        },
        { signal: lifecycle.signal }
      );
      const submit = section.querySelector<HTMLButtonElement>("[data-submit]")!;
      submit.addEventListener(
        "click",
        async () => {
          const value = input.value.trim();
          if (!value || submit.disabled) return;
          submit.disabled = true;
          clearFeedback();
          const parent = section.dataset.replyTo;
          const editId = section.dataset.editId;
          try {
            await requestBlogApi(
              editId
                ? `${api}/blog/comments/${editId}`
                : `${api}/blog/comments`,
              {
                method: editId ? "PATCH" : "POST",
                signal: lifecycle.signal,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(
                  editId
                    ? {
                        body: value,
                        version: Number(section.dataset.editVersion),
                      }
                    : {
                        id: crypto.randomUUID(),
                        post,
                        post_title: section.dataset.postTitle,
                        body: value,
                        parent_id: parent || undefined,
                        subscribe: subscribe.checked,
                      }
                ),
              }
            );
            if (lifecycle.signal.aborted || !section.isConnected) return;
            input.value = "";
            delete section.dataset.replyTo;
            delete section.dataset.editId;
            delete section.dataset.editVersion;
            input.placeholder = "Leave a comment…";
            await loadComments("refresh");
          } catch (error) {
            showActionError(
              editId ? "Editing comment" : "Sending comment",
              error
            );
          } finally {
            submit.disabled = false;
          }
        },
        { signal: lifecycle.signal }
      );
      list.addEventListener(
        "click",
        async event => {
          const target = (event.target as HTMLElement).closest<HTMLElement>(
            "[data-delete],[data-reply],[data-edit],[data-retry]"
          );
          if (!target) return;
          if (target.dataset.retry !== undefined) {
            void loadComments("retry");
            return;
          }
          const id = target.dataset.delete;
          if (id) {
            const button = target as HTMLButtonElement;
            if (button.disabled || !confirm("Delete this comment?")) return;
            button.disabled = true;
            clearFeedback();
            try {
              await requestBlogApi(`${api}/blog/comments/${id}`, {
                method: "DELETE",
                signal: lifecycle.signal,
              });
              await loadComments("refresh");
            } catch (error) {
              showActionError("Deleting comment", error);
            } finally {
              button.disabled = false;
            }
            return;
          }
          if (target.dataset.reply) {
            section.dataset.replyTo = target.dataset.reply;
            input.focus();
            input.placeholder = "Reply to this comment…";
            return;
          }
          if (target.dataset.edit) {
            const article = target.closest<HTMLElement>(".comment")!;
            section.dataset.editId = target.dataset.edit;
            section.dataset.editVersion = target.dataset.version;
            input.value = article.dataset.commentBody ?? "";
            input.placeholder = "Edit your comment…";
            input.focus();
          }
        },
        { signal: lifecycle.signal }
      );
      loadEmojiManifest().then(manifest => {
        if (lifecycle.signal.aborted || !section.isConnected) return;
        emojiManifest = manifest;
        emojiIndex = manifest ? createEmojiIndex(manifest) : new Map();
        try {
          renderEmojiPicker(manifest);
          if (!preview.hidden) preview.innerHTML = renderMarkdown(input.value);
          rerenderComments?.();
        } catch (error) {
          showError(error);
        }
      });
      void loadComments();
    }
  }
  document.addEventListener("astro:before-swap", () => {
    for (const lifecycle of mounted.values()) lifecycle.abort();
    mounted.clear();
  });
  document.addEventListener("astro:page-load", initComments);
  initComments();
</script>
