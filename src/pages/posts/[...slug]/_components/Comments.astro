---
import EmojiPicker from "@/components/EmojiPicker.astro";

const { postSlug } = Astro.props;
const api = import.meta.env.PUBLIC_BLOG_API ?? "https://api.loopo.cc";
const debug = import.meta.env.PUBLIC_COMMENTS_DEBUG === "true";
---

<section
  class="comments"
  id="comments"
  data-comments-api={api}
  data-post={postSlug}
  data-comments-debug={debug ? "true" : undefined}
>
  <div class="comments-heading">
    <h2>Leave a comment</h2><span class="comments-count" data-count
      >Loading</span
    >
  </div>
  <div class="comments-editor" data-editor hidden>
    <div class="comments-editor-header">
      <div class="comments-tabs">
        <button class="comments-tab" data-tab="write" aria-selected="true"
          >Write</button
        ><button class="comments-tab" data-tab="preview" aria-selected="false"
          >Preview(Markdown)</button
        >
      </div>
      <EmojiPicker />
    </div>
    <textarea
      data-input
      maxlength="2000"
      rows="4"
      placeholder="Leave a comment…"></textarea>
    <div class="comment-preview" data-preview hidden></div>
    <div class="comments-editor-footer">
      <label class="comment-subscribe"
        ><input type="checkbox" data-subscribe /><span
          class="comment-check"
          aria-hidden="true"></span><span
          >Email me about new comments on this article</span
        ></label
      ><button type="button" class="comment-submit" data-submit>Send</button>
    </div>
  </div>
  <div class="comments-login" data-login hidden>
    <span>Log in to join the discussion.</span>
    <a data-login-link>Log in</a>
  </div>
  <div class="comments-list" data-list>
    <p class="comments-loading">Loading comments…</p>
  </div>
</section>
<script>
  import { marked } from "marked";
  import DOMPurify from "dompurify";
  import {
    createEmojiIndex,
    splitEmojiText,
    type EmojiItem,
    type EmojiManifest,
  } from "@/utils/emoji";

  let emojiManifestPromise: Promise<EmojiManifest | null> | undefined;
  const loadEmojiManifest = () => {
    if (!emojiManifestPromise) {
      emojiManifestPromise = fetch("/emoji/manifest.json", {
        cache: "force-cache",
      })
        .then(async response => {
          if (!response.ok) return null;
          const manifest = (await response.json()) as EmojiManifest;
          return Array.isArray(manifest.groups) ? manifest : null;
        })
        .catch(() => null);
    }
    return emojiManifestPromise;
  };

  const sections = [...document.querySelectorAll<HTMLElement>(".comments")];
  for (const [sectionIndex, section] of sections.entries()) {
    const api = section.dataset.commentsApi!,
      post = section.dataset.post!,
      list = section.querySelector<HTMLElement>("[data-list]")!,
      editor = section.querySelector<HTMLElement>("[data-editor]")!,
      login = section.querySelector<HTMLElement>("[data-login]")!,
      input = section.querySelector<HTMLTextAreaElement>("[data-input]")!,
      preview = section.querySelector<HTMLElement>("[data-preview]")!,
      count = section.querySelector<HTMLElement>("[data-count]")!,
      subscribe = section.querySelector<HTMLInputElement>("[data-subscribe]")!,
      picker = section.querySelector<HTMLElement>("[data-emoji-picker]")!,
      emojiTrigger = picker.querySelector<HTMLButtonElement>(
        "[data-emoji-trigger]"
      )!,
      emojiPanel = picker.querySelector<HTMLElement>("[data-emoji-panel]")!,
      emojiTabs = picker.querySelector<HTMLElement>("[data-emoji-tabs]")!,
      emojiContents = picker.querySelector<HTMLElement>(
        "[data-emoji-contents]"
      )!,
      emojiEmpty = picker.querySelector<HTMLElement>("[data-emoji-empty]")!;
    const debugEnabled = section.dataset.commentsDebug === "true";
    const startedAt = performance.now();
    let emojiManifest: EmojiManifest | null = null;
    let emojiIndex: ReadonlyMap<string, EmojiItem> = new Map();
    let rerenderComments: (() => void) | undefined;
    const debugLog = (event: string, details: Record<string, unknown> = {}) => {
      if (!debugEnabled) return;
      globalThis.console.debug(
        `[comments][${new Date().toISOString()}][+${(performance.now() - startedAt).toFixed(1)}ms] ${event}`,
        details
      );
    };
    debugLog("init", { post });
    const safe = (value: unknown) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]!
      );
    section.querySelector<HTMLAnchorElement>("[data-login-link]")!.href =
      `${api}/blog/auth/login?returnTo=${encodeURIComponent(location.href + "#comments")}`;
    const replyMarker =
      '<span class="comment-reply-marker" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20h-7a4 4 0 0 1-4-4V4"></path><path d="m14 9-5-5-5 5"></path></svg></span>';

    const renderMarkdown = (value: string) => {
      if (!emojiManifest) {
        return DOMPurify.sanitize(
          marked.parse(value, { async: false }) as string,
          {
            USE_PROFILES: { html: true },
          }
        );
      }
      const html = DOMPurify.sanitize(
        marked.parse(value, { async: false }) as string,
        { USE_PROFILES: { html: true } }
      );
      const container = document.createElement("div");
      container.innerHTML = html;
      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      while (walker.nextNode()) textNodes.push(walker.currentNode as Text);
      for (const textNode of textNodes) {
        if (textNode.parentElement?.closest("code, pre")) continue;
        const text = textNode.nodeValue ?? "";
        const parts = splitEmojiText(text, emojiIndex);
        if (parts.length === 1) continue;
        const fragment = document.createDocumentFragment();
        for (const part of parts) {
          if (typeof part === "string") {
            fragment.append(document.createTextNode(part));
            continue;
          }
          const image = document.createElement("img");
          image.className = "comment-emoji";
          image.src = part.src;
          image.alt = part.alt;
          image.title = part.alt;
          image.draggable = false;
          image.loading = "lazy";
          fragment.append(image);
        }
        textNode.parentNode?.replaceChild(fragment, textNode);
      }
      return container.innerHTML;
    };
    const setEmojiPanelOpen = (open: boolean, restoreFocus = false) => {
      emojiPanel.hidden = !open;
      emojiTrigger.setAttribute("aria-expanded", String(open));
      if (open) {
        picker
          .querySelector<HTMLButtonElement>("[data-emoji-id]")
          ?.focus({ preventScroll: true });
      } else if (restoreFocus) {
        emojiTrigger.focus({ preventScroll: true });
      }
    };
    let closeTimer: number | undefined;
    const cancelEmojiClose = () => {
      if (closeTimer !== undefined) window.clearTimeout(closeTimer);
      closeTimer = undefined;
    };
    const scheduleEmojiClose = () => {
      cancelEmojiClose();
      closeTimer = window.setTimeout(() => setEmojiPanelOpen(false), 120);
    };
    const activateEmojiGroup = (groupId: string) => {
      emojiTabs
        .querySelectorAll<HTMLButtonElement>("[data-emoji-tab]")
        .forEach(tab => {
          const active = tab.dataset.emojiTab === groupId;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });
      emojiContents
        .querySelectorAll<HTMLElement>("[data-emoji-content]")
        .forEach(content => {
          content.hidden = content.dataset.emojiContent !== groupId;
        });
    };
    const renderEmojiPicker = (manifest: EmojiManifest | null) => {
      emojiTabs.replaceChildren();
      emojiContents.replaceChildren();
      emojiEmpty.hidden = Boolean(manifest);
      emojiTrigger.disabled = !manifest;
      if (!manifest) return;
      for (const [index, group] of manifest.groups.entries()) {
        const tab = document.createElement("button");
        tab.type = "button";
        tab.className = "emoji-tab";
        tab.dataset.emojiTab = group.id;
        tab.id = `emoji-tab-${sectionIndex}-${group.id}`;
        tab.setAttribute("role", "tab");
        tab.setAttribute(
          "aria-controls",
          `emoji-content-${sectionIndex}-${group.id}`
        );
        tab.textContent = group.label;
        tab.tabIndex = index === 0 ? 0 : -1;
        emojiTabs.append(tab);

        const content = document.createElement("section");
        content.className = "emoji-content";
        content.dataset.emojiContent = group.id;
        content.id = `emoji-content-${sectionIndex}-${group.id}`;
        content.setAttribute("role", "tabpanel");
        content.setAttribute("aria-labelledby", tab.id);
        content.hidden = index !== 0;
        const grid = document.createElement("div");
        grid.className = "emoji-grid";
        for (const item of group.items) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "emoji-item";
          button.dataset.emojiId = item.id;
          button.title = item.alt;
          button.setAttribute("aria-label", item.alt);
          const image = document.createElement("img");
          image.src = item.src;
          image.alt = item.alt;
          image.loading = "lazy";
          image.decoding = "async";
          button.append(image);
          grid.append(button);
        }
        content.append(grid);
        emojiContents.append(content);
      }
    };
    const pickerId = `emoji-panel-${sectionIndex}`;
    emojiPanel.id = pickerId;
    emojiTrigger.setAttribute("aria-controls", pickerId);
    emojiTrigger.addEventListener("click", () => {
      cancelEmojiClose();
      setEmojiPanelOpen(Boolean(emojiPanel.hidden));
    });
    picker.addEventListener("pointerenter", () => {
      cancelEmojiClose();
      setEmojiPanelOpen(true);
    });
    picker.addEventListener("pointerleave", scheduleEmojiClose);
    picker.addEventListener("focusin", cancelEmojiClose);
    picker.addEventListener("focusout", event => {
      if (!picker.contains(event.relatedTarget as Node | null))
        scheduleEmojiClose();
    });
    emojiPanel.addEventListener("pointerenter", cancelEmojiClose);
    emojiPanel.addEventListener("pointerdown", event =>
      event.stopPropagation()
    );
    emojiPanel.addEventListener("wheel", event => event.stopPropagation(), {
      passive: true,
    });
    emojiPanel.addEventListener("touchmove", event => event.stopPropagation(), {
      passive: true,
    });
    picker.addEventListener("click", event => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-emoji-tab]"
      );
      if (tab) {
        activateEmojiGroup(tab.dataset.emojiTab!);
        return;
      }
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-emoji-id]"
      );
      if (!target) return;
      const start = input.selectionStart ?? input.value.length;
      const end = input.selectionEnd ?? start;
      input.setRangeText(`(${target.dataset.emojiId})`, start, end, "end");
      input.dispatchEvent(new Event("input", { bubbles: true }));
      setEmojiPanelOpen(false);
      input.focus();
    });
    picker.addEventListener("keydown", event => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-emoji-tab]"
      );
      if (!tab || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
      const tabs = [
        ...emojiTabs.querySelectorAll<HTMLButtonElement>("[data-emoji-tab]"),
      ];
      const current = tabs.indexOf(tab);
      const next =
        (current + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) %
        tabs.length;
      event.preventDefault();
      activateEmojiGroup(tabs[next].dataset.emojiTab!);
      tabs[next].focus();
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && !emojiPanel.hidden)
        setEmojiPanelOpen(false, true);
    });
    document.addEventListener("pointerdown", event => {
      if (!emojiPanel.hidden && !picker.contains(event.target as Node))
        setEmojiPanelOpen(false);
    });

    const showIdentity = (authenticated: boolean) => {
      editor.hidden = !authenticated;
      login.hidden = authenticated;
      debugLog("identity-state", { authenticated });
    };
    section.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach(tab =>
      tab.addEventListener("click", () => {
        const isPreview = tab.dataset.tab === "preview";
        section
          .querySelectorAll<HTMLButtonElement>("[data-tab]")
          .forEach(item =>
            item.setAttribute("aria-selected", String(item === tab))
          );
        input.hidden = isPreview;
        preview.hidden = !isPreview;
        if (isPreview) preview.innerHTML = renderMarkdown(input.value);
      })
    );
    async function loadComments() {
      const requestStarted = performance.now();
      debugLog("comments-request-start");
      const response = await fetch(
        `${api}/blog/comments?post=${encodeURIComponent(post)}`,
        { credentials: "include" }
      );
      debugLog("comments-response", {
        status: response.status,
        ms: +(performance.now() - requestStarted).toFixed(1),
      });
      if (!response.ok) throw new Error();
      const payload = await response.json();
      debugLog("comments-payload", {
        total: payload.total,
        items: payload.items?.length,
        viewer: Boolean(payload.viewer),
      });
      count.textContent = `${payload.total} comments`;
      subscribe.checked = payload.subscribed;
      showIdentity(Boolean(payload.viewer));
      const items = payload.items as any[];
      const ids = new Set(items.map(item => item.id));
      const byParent = new Map<string | null, any[]>();
      for (const item of items) {
        const key =
          item.parent_id && ids.has(item.parent_id) ? item.parent_id : null;
        byParent.set(key, [...(byParent.get(key) ?? []), item]);
      }
      const renderCommentList = () => {
        const render = (item: any, depth: number): string => {
          const createdAt = new Date(item.created_at);
          const formattedTime = createdAt.toLocaleString(undefined, {
            dateStyle: "medium",
            timeStyle: "short",
          });
          return `<article class="comment${item.parent_id ? " comment--reply" : ""}" style="--comment-depth:${Math.min(depth, 3)}" data-comment-id="${safe(item.id)}" data-comment-body="${safe(item.body)}">${item.parent_id ? replyMarker : ""}<div class="comment-meta"><strong>${item.author_url ? `<a href="${safe(item.author_url)}" target="_blank" rel="noopener noreferrer">${safe(item.author_name)}</a>` : safe(item.author_name)}</strong><time datetime="${createdAt.toISOString()}">${formattedTime}</time></div>${item.deleted_at ? `<p class="account-muted">Comment removed by a moderator.</p>` : `<div class="comment-content">${renderMarkdown(item.body)}</div>`}<div class="comment-actions">${item.can_edit ? `<button class="comment-action" data-edit="${safe(item.id)}" data-version="${item.version}">Edit</button>` : ""}${item.can_delete ? `<button class="comment-action" data-delete="${safe(item.id)}">Delete</button>` : ""}${!item.deleted_at ? `<button class="comment-action" data-reply="${safe(item.id)}">Reply</button>` : ""}</div></article>`;
        };
        const ordered: string[] = [];
        const flatten = (item: any, depth: number) => {
          ordered.push(render(item, depth));
          for (const child of byParent.get(item.id) ?? [])
            flatten(child, depth + 1);
        };
        for (const item of byParent.get(null) ?? []) flatten(item, 0);
        list.innerHTML =
          ordered.join("") ||
          `<p class="comments-empty">No comments yet. Be first to share your thoughts.</p>`;
        debugLog("comments-rendered", { items: ordered.length });
      };
      rerenderComments = renderCommentList;
      renderCommentList();
    }
    subscribe.addEventListener("change", async () => {
      await fetch(
        `${api}/blog/account/subscriptions/${encodeURIComponent(post)}`,
        {
          method: "PUT",
          credentials: "include",
          headers: {
            "Content-Type": "application/json",
            Origin: location.origin,
          },
          body: JSON.stringify({ enabled: subscribe.checked }),
        }
      );
    });
    section
      .querySelector("[data-submit]")
      ?.addEventListener("click", async () => {
        const value = input.value.trim();
        if (!value) return;
        const parent = section.dataset.replyTo;
        const editId = section.dataset.editId;
        const response = editId
          ? await fetch(`${api}/blog/comments/${editId}`, {
              method: "PATCH",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
                Origin: location.origin,
              },
              body: JSON.stringify({
                body: value,
                version: Number(section.dataset.editVersion),
              }),
            })
          : await fetch(`${api}/blog/comments`, {
              method: "POST",
              credentials: "include",
              headers: {
                "Content-Type": "application/json",
                Origin: location.origin,
              },
              body: JSON.stringify({
                id: crypto.randomUUID(),
                post,
                body: value,
                parent_id: parent || undefined,
                subscribe: subscribe.checked,
              }),
            });
        if (response.ok) {
          input.value = "";
          delete section.dataset.replyTo;
          delete section.dataset.editId;
          delete section.dataset.editVersion;
          input.placeholder = "Leave a comment…";
          await loadComments();
        } else if (response.status === 401) {
          showIdentity(false);
        }
      });
    list.addEventListener("click", async event => {
      const target = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-delete],[data-reply],[data-edit]"
      );
      if (!target) return;
      const id = target.dataset.delete;
      if (id) {
        if (!confirm("Delete this comment?")) return;
        const response = await fetch(`${api}/blog/comments/${id}`, {
          method: "DELETE",
          credentials: "include",
          headers: { Origin: location.origin },
        });
        if (response.status === 401) showIdentity(false);
        await loadComments();
        return;
      }
      if (target.dataset.reply) {
        section.dataset.replyTo = target.dataset.reply;
        input.focus();
        input.placeholder = "Reply to this comment…";
        return;
      }
      if (target.dataset.edit) {
        const article = target.closest<HTMLElement>(".comment")!;
        section.dataset.editId = target.dataset.edit;
        section.dataset.editVersion = target.dataset.version;
        input.value = article.dataset.commentBody ?? "";
        input.placeholder = "Edit your comment…";
        input.focus();
      }
    });
    loadEmojiManifest().then(manifest => {
      emojiManifest = manifest;
      emojiIndex = manifest ? createEmojiIndex(manifest) : new Map();
      renderEmojiPicker(manifest);
      if (!preview.hidden) preview.innerHTML = renderMarkdown(input.value);
      rerenderComments?.();
    });
    loadComments().catch(() => {
      list.innerHTML = `<p class="comments-empty">Comments are temporarily unavailable.</p>`;
      count.textContent = "";
    });
  }
</script>
